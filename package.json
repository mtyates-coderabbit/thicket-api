{
  "name": "thicket-api",
  "version": "0.1.0",
  "private": true,
  "description": "GraphQL API for the Thicket storefront.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:diff": "tsx scripts/schema-diff.ts",
    "operations:validate": "tsx scripts/validate-operations.ts"
  },
  "dependencies": {
    "graphql": "^16.14.2",
    "graphql-yoga": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
